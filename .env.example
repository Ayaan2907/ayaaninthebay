# copy to .env.local for local dev (`npm run dev` loads it). in production set these on the
# railway service (Variables tab). every var here is read in exactly one place: api/_env.js.
# `npm run check` fails if the two drift.

# ── runtime ──────────────────────────────────────────────────────────────
# PORT is set by railway. NODE_ENV=production turns off handler hot-reload and adds hsts.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info                    # debug | info | warn | error. debug logs every request.
SITE_URL=https://ayaan.sh         # canonical url, used in feed.xml

# ── puter (one token powers chat, /build and /call) ──────────────────────
# puter.com → settings → api token. free models on a free account: gpt-4.1, gpt-4.1-mini,
# gpt-4o, gpt-4o-mini, gpt-5-mini, gpt-5-nano, deepseek-chat. claude models need credits.
# rotate it at puter.com if it ever leaks; nothing else needs to change.
PUTER_AUTH_TOKEN=

# ── chat: the ai version of me (/api/chat) ───────────────────────────────
# provider picks itself: puter when PUTER_AUTH_TOKEN is set, else anthropic, else off.
CHAT_PROVIDER=                    # puter | anthropic | none (optional override)
CHAT_MODEL=gpt-4.1                # puter model id
CHAT_PER_HOUR=60                  # messages per ip per hour
ANTHROPIC_API_KEY=                # only for CHAT_PROVIDER=anthropic and scripts/publish.mjs
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── /build: "hey ayaan, build me this" (/api/build) ──────────────────────
# owner   builds run on the server with my token; visitors never sign in. default when the token is set.
# visitor the browser does it with puter.js; the visitor signs in and pays.
# off     disabled. BUILD_KILL=1 is the emergency switch and beats everything else.
BUILD_MODE=
BUILD_MODEL=gpt-4.1
BUILD_PER_HOUR=3                  # builds per ip per hour
BUILD_DAILY_CAP=60                # builds per day, whole site
# BUILD_KILL=1

# ── /call: voice (/api/tts) ──────────────────────────────────────────────
TTS_VOICE=Matthew                 # any polly neural voice puter exposes: Matthew, Joanna, Stephen, Ruth…
TTS_PER_HOUR=240                  # sentences per ip per hour

# ── github activity (/api/github, the city's vans and lit windows) ───────
GITHUB_USER=Ayaan2907
GITHUB_TOKEN=                     # optional. any token with no scopes unlocks the full-year contribution calendar.
